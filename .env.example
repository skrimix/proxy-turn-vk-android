# Copy this file to .env and replace the password before starting the server.
WDTT_PASSWORD=replace-with-a-long-random-password

# Server ports. DTLS also carries the TCP API; Raw mode is enabled for new clients.
WDTT_DTLS_PORT=56000
WDTT_WG_PORT=56001
WDTT_RAW_PORT=56003

# Optional direct RTP-obfs listener; disabled by default. If enabled, publish the
# same UDP port under services.server.ports in compose.yaml.
WDTT_DIRECT_PORT=

# Sent to VPN clients in their WireGuard configuration.
WDTT_DNS=1.1.1.1,1.0.0.1

# Optional additional whitespace-separated wdtt-server arguments.
WDTT_ARGS=

# Optional Telegram bot administration.
WDTT_ADMIN_ID=
WDTT_BOT_TOKEN=

# APK release used by the Docker build. Update the URL and checksum together.
WDTT_APK_URL=https://github.com/SpaceNeuroX/proxy-turn-vk-android/releases/download/v1.4.0-beta/app-arm64-v8a-release.apk
WDTT_APK_SHA256=fe8feffbb982007b7beed47f5581aee3b1e9b0a7133cd33339458c8e63625f5f
